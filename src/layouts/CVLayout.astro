---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n';

interface Props {
  title?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = 'CV - Julien Syx' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored || preferred);
      })();
    </script>
  </head>
  <body class="cv-body">
    <div class="cv-toolbar no-print">
      <a href={lang === 'fr' ? '/' : '/en/'} class="cv-back">&larr; {t('misc.backHome')}</a>
      <button id="print-btn" class="btn btn-primary" onclick="window.print()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {t('misc.downloadCV')}
      </button>
    </div>
    <div class="cv-page">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  .cv-body {
    background: var(--color-bg-subtle);
    min-height: 100vh;
  }

  .cv-toolbar {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cv-back {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .cv-back:hover {
    color: var(--color-primary);
  }

  .cv-page {
    max-width: 900px;
    margin: 0 auto var(--space-2xl);
    background: var(--color-bg-alt);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 280px 1fr;
  }

  /* Sidebar */
  .cv-sidebar {
    background: var(--color-primary-dark);
    color: #fff;
    padding: var(--space-2xl) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .cv-photo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(255, 255, 255, 0.3);
    margin: 0 auto;
  }

  .cv-identity {
    text-align: center;
  }

  .cv-name {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: var(--space-xs);
    color: #fff;
  }

  .cv-title {
    font-size: 0.85rem;
    opacity: 0.85;
    line-height: 1.4;
  }

  .cv-section-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-accent);
  }

  .cv-sidebar .cv-section-title {
    color: var(--color-accent);
  }

  .cv-contact-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cv-contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .cv-contact-item svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .cv-contact-item a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
  }

  .cv-skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cv-skill-tag {
    display: inline-block;
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
  }

  a.cv-skill-tag:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  .cv-sidebar-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cv-sidebar-item {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
  }

  .cv-sidebar-item strong {
    color: #fff;
  }

  /* Main content */
  .cv-main {
    padding: var(--space-2xl) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .cv-main .cv-section-title {
    color: var(--color-primary);
    border-bottom-color: var(--color-border);
    margin-bottom: var(--space-md);
  }

  .cv-profile {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Experience entries */
  .cv-entry {
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border-light);
  }

  .cv-entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .cv-entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: 2px;
  }

  .cv-entry-company {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .cv-entry-period {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  .cv-entry-role {
    font-size: 0.82rem;
    color: var(--color-primary);
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .cv-entry-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .cv-entry-highlights {
    list-style: none;
    padding: 0;
    margin-top: var(--space-xs);
  }

  .cv-entry-highlights li {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    padding-left: 12px;
    position: relative;
  }

  .cv-entry-highlights li::before {
    content: '>';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.7rem;
  }

  /* Education */
  .cv-edu-item {
    margin-bottom: var(--space-sm);
  }

  .cv-edu-school {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .cv-edu-degree {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  /* Engagements compact */
  .cv-engagement-item {
    margin-bottom: var(--space-xs);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .cv-engagement-item strong {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Print styles */
  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    html, body {
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Force light mode for print */
    :root {
      --color-bg: #fff !important;
      --color-bg-alt: #fff !important;
      --color-bg-subtle: #f5f5f5 !important;
      --color-text: #111 !important;
      --color-text-muted: #555 !important;
      --color-border: #ddd !important;
      --color-border-light: #eee !important;
      --color-primary: #6b46ff !important;
      --color-primary-dark: #3b1f8e !important;
      --color-accent: #c7b8ff !important;
    }

    .no-print {
      display: none !important;
    }

    .cv-body {
      background: #fff;
    }

    .cv-page {
      margin: 0;
      border-radius: 0;
      box-shadow: none;
      max-width: none;
      min-height: 100vh;
    }

    .cv-sidebar {
      background: #3b1f8e !important;
    }

    .cv-main {
      padding: var(--space-xl);
    }

    .cv-entry {
      break-inside: avoid;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .cv-page {
      grid-template-columns: 1fr;
      margin: 0 var(--space-md) var(--space-2xl);
    }

    .cv-sidebar {
      padding: var(--space-xl);
    }

    .cv-photo {
      width: 100px;
      height: 100px;
    }
  }
</style>
