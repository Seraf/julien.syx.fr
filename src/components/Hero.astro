---
import { getLangFromUrl, useTranslations, getNavLinks } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const parcoursPath = lang === 'fr' ? '/parcours/' : '/en/journey/';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-greeting">{t('hero.greeting')}</p>
      <h1 class="hero-name">{t('hero.name')}</h1>
      <p class="hero-title">
        <span class="hero-role">{t('hero.title')}</span>
        <span class="hero-at">@</span>
        <a href="https://www.cycloid.io" target="_blank" rel="noopener" class="hero-company">{t('hero.subtitle')}</a>
      </p>
      <p class="hero-description">{t('hero.description')}</p>
      <div class="hero-actions">
        <a href={parcoursPath} class="btn btn-primary">{t('hero.cta.parcours')}</a>
        <a href="#contact" class="btn btn-outline">{t('hero.cta.contact')}</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/photo-julien.jpg" alt="Julien Syx" width="300" height="300" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0;
    min-height: calc(80vh - var(--header-height));
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3xl);
  }

  .hero-content {
    flex: 1;
  }

  .hero-greeting {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title {
    font-size: 1.3rem;
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hero-role {
    font-weight: 600;
    color: var(--color-text);
  }

  .hero-at {
    color: var(--color-text-muted);
  }

  .hero-company {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .hero-company:hover {
    text-decoration: underline;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .hero-photo img {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-3xl) 0;
    }

    .hero-inner {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-name {
      font-size: 2.5rem;
    }

    .hero-title {
      justify-content: center;
    }

    .hero-description {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-photo img {
      width: 200px;
      height: 200px;
    }
  }
</style>
