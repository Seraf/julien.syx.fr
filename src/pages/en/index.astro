---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import SkillGroup from '../../components/SkillGroup.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EngagementCard from '../../components/EngagementCard.astro';
import { useTranslations } from '../../i18n';
import { experiences } from '../../data/experience';
import { skillGroups } from '../../data/skills';
import { projects } from '../../data/projects';
import { engagements } from '../../data/engagements';
import { parcoursSteps } from '../../data/parcours';

const lang = 'en';
const t = useTranslations(lang);

const topExperiences = experiences.slice(0, 3);
const topProjects = projects.slice(0, 3);
const topEngagements = engagements.slice(0, 3);
const topParcours = parcoursSteps.slice(0, 4);
---

<BaseLayout title="Julien Syx - CTO / Product Lead">
  <Hero />

  <section class="section" id="journey">
    <div class="container">
      <SectionHeading title={t('section.parcours')} subtitle={t('section.parcours.subtitle')} />
      <div class="timeline-preview">
        {topParcours.map(step => (
          <TimelineItem
            title={t(`parcours.${step.key}.title` as any)}
            period={t(`parcours.${step.key}.period` as any)}
            text={t(`parcours.${step.key}.text` as any)}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href="/en/journey/" class="btn btn-outline">{t('misc.seeMore')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <SectionHeading title={t('section.experience')} subtitle={t('section.experience.subtitle')} />
      <div class="experience-list">
        {topExperiences.map(exp => (
          <ExperienceCard
            company={exp.company}
            role={exp.role[lang]}
            period={exp.period}
            location={exp.location}
            description={exp.description[lang]}
            highlights={exp.highlights[lang]}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href="/en/experience/" class="btn btn-outline">{t('misc.seeMore')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="skills">
    <div class="container">
      <SectionHeading title={t('section.skills')} subtitle={t('section.skills.subtitle')} />
      <div class="skills-grid">
        {skillGroups.map(group => (
          <SkillGroup category={group.category[lang]} skills={group.skills} />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <SectionHeading title={t('section.realisations')} subtitle={t('section.realisations.subtitle')} />
      <div class="grid-3">
        {topProjects.map(project => (
          <ProjectCard
            name={project.name}
            url={project.url}
            description={project.description[lang]}
            tech={project.tech}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href="/en/projects/" class="btn btn-outline">{t('misc.seeMore')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="commitments">
    <div class="container">
      <SectionHeading title={t('section.engagements')} subtitle={t('section.engagements.subtitle')} />
      <div class="engagements-list">
        {topEngagements.map(eng => (
          <EngagementCard
            title={eng.title[lang]}
            organization={eng.organization}
            period={eng.period}
            description={eng.description[lang]}
            category={eng.category}
          />
        ))}
      </div>
      <div class="section-cta">
        <a href="/en/commitments/" class="btn btn-outline">{t('misc.seeMore')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <SectionHeading title={t('contact.title')} subtitle={t('contact.subtitle')} />
      <div class="contact-links">
        <a href="mailto:julien@syx.fr" class="contact-link card fade-in">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <span>{t('contact.email')}</span>
          <span class="contact-value">julien@syx.fr</span>
        </a>
        <a href="https://www.linkedin.com/in/juliensyx" target="_blank" rel="noopener" class="contact-link card fade-in">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>{t('contact.linkedin')}</span>
          <span class="contact-value">linkedin.com/in/juliensyx</span>
        </a>
        <a href="https://github.com/Seraf" target="_blank" rel="noopener" class="contact-link card fade-in">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span>{t('contact.github')}</span>
          <span class="contact-value">github.com/Seraf</span>
        </a>
      </div>
      <div class="contact-cv fade-in">
        <a href="/en/cv/" class="btn btn-primary">{t('misc.downloadCV')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline-preview { max-width: 700px; margin: 0 auto; }
  .experience-list { display: flex; flex-direction: column; gap: var(--space-lg); }
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-xl); }
  .engagements-list { display: flex; flex-direction: column; gap: var(--space-lg); }
  .section-cta { text-align: center; margin-top: var(--space-2xl); }
  .contact-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--space-lg); max-width: 800px; margin: 0 auto; }
  .contact-link { display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); text-align: center; text-decoration: none; color: inherit; padding: var(--space-xl); }
  .contact-link svg { color: var(--color-primary); }
  .contact-link span:first-of-type { font-weight: 600; font-size: 1rem; }
  .contact-value { font-size: 0.85rem; color: var(--color-text-muted); }
  .contact-cv { text-align: center; margin-top: var(--space-2xl); }
</style>
